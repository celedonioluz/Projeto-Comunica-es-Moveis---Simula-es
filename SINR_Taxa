    x,y = ecdf(Bw * results_sit2[K]['rate_stat'] / 1e6)
    plt.plot(x,y,'--',color=c,label=f'ECSI - K = {K}')
    x,y = ecdf(Bw * results_sit2[K]['rate_inst'] / 1e6)
    plt.plot(x,y,'-',color=c,label=f'PCSI - K = {K}')
